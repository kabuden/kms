# ── 데이터 소스 ─────────────────────────────────────────────
# true(기본): 합성 데이터로 완전 오프라인 동작(데모/백테스트 재현 가능)
# false      : yfinance 시세 + RSS 뉴스 실데이터 사용 (네트워크 필요)
SA_OFFLINE=true

# ── LLM 예측 에이전트 (#5) ──────────────────────────────────
# true 이고 ANTHROPIC_API_KEY 가 있으면 LLM 추론, 없으면 휴리스틱 폴백
SA_USE_LLM=false
ANTHROPIC_API_KEY=
SA_LLM_MODEL=claude-fable-5

# ── 실거래 신뢰도 게이트 ────────────────────────────────────
# 최소 학습 사이클 수 / 최소 롤링 정확도 / 롤링 윈도우
SA_MIN_CYCLES=10
SA_MIN_ACCURACY=0.58
SA_ROLLING_WINDOW=20
